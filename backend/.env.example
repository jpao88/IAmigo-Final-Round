# Copiar para .env e preencher. O .env nunca vai para o GitHub.

# Banco de dados (Aiven: dados em Overview > Connection information)
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=iamigo
# Caminho do ca.pem baixado do Aiven, fora do repositório. Vazio = sem SSL (MySQL local).
DB_SSL_CA=C:/Users/seu-usuario/certs/aiven/ca.pem
# No hosting (sem arquivo): o conteúdo do ca.pem numa variável secreta, no lugar de DB_SSL_CA.
# DB_SSL_CA_PEM=

# Login (JWT). Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 43200 = 30 dias: a pessoa não precisa entrar de novo todo dia.
JWT_EXPIRA_MINUTOS=43200

# Documentação interativa da API em /docs (sim/nao). Publicada: nao.
DOCS_ABERTOS=sim

# IA
GEMINI_API_KEY=

# Origens do front permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# Opcional: testar no celular na mesma rede Wi-Fi (qualquer IP local, porta 5500).
# Deixar vazio quando a app estiver publicada.
CORS_ORIGIN_REGEX=
